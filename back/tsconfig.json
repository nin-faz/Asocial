{
  "compilerOptions": {
    "rootDirs": ["src"],
    "outDir": "dist",
    "target": "es2020",
    "module": "esnext",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["es2020", "esnext", "dom"],
    "skipLibCheck": true,
    "noEmitOnError": false
  }
}
